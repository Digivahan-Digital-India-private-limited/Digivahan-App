<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ui.Activities.notification.ViewNotification">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Content not found"
                    android:gravity="center"
                    android:visibility="gone"
                    android:fontFamily="@font/hind_medium"
                    android:layout_marginTop="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/issueIcon"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        />

                    <TextView
                        android:id="@+id/titleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:gravity="center"
                        android:textSize="20sp"
                        android:fontFamily="@font/hind_bold"
                        android:layout_marginVertical="10dp"/>

                    <TextView
                        android:id="@+id/descriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingHorizontal="5dp"
                        android:fontFamily="@font/hind"
                        android:layout_marginTop="10dp"/>

                    <LinearLayout
                        android:id="@+id/locationCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alert Location"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:paddingHorizontal="5dp"
                            android:fontFamily="@font/hind"
                            android:layout_marginTop="10dp"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="20dp"
                            android:layout_gravity="center"
                            android:elevation="0dp"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="130dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/google_map_temp_img" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAccidentAlertImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:padding="4dp"
                        android:scrollbars="vertical" />

                    <TextView
                        android:id="@+id/vehicleMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:gravity="center"
                        android:textSize="16sp"
                        android:paddingHorizontal="5dp"
                        android:fontFamily="@font/hind"
                        android:layout_marginTop="10dp"/>

                    <LinearLayout
                        android:id="@+id/sendWhatsAppBtn"
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:backgroundTint="@color/colorPrimary"
                        app:layout_flexShrink="1"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginVertical="5dp"
                        android:layout_marginStart="5dp"
                        android:minWidth="120dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/chat_icon"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:drawablePadding="5dp"
                            android:fontFamily="@font/hind_bold"
                            android:text="Chat"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            app:layout_flexShrink="1" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/viewImage"
                    android:layout_width="match_parent"
                    android:layout_height="600dp"
                    android:layout_gravity="center"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="10dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/image_loading"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/viewImageCrossIcon"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="25dp"
                    android:src="@drawable/close_icon"
                    android:visibility="gone" />

            </FrameLayout>




        </FrameLayout>

    </ScrollView>

</LinearLayout>