<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".ui.Fragments.myGarageInfoPages.DetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="12dp"
            android:padding="12dp"
            app:cardElevation="2dp">

            <!-- RC Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Ownership Details Card -->
                <include
                    android:id="@+id/ownershipDetails"
                    layout="@layout/item_ownership_details" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_1" />

                <!-- Vehicle Details Card -->
                <include
                    android:id="@+id/vehicleDetails"
                    layout="@layout/item_vehicle_details" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_1" />

                <!-- Important Dates Card -->
                <include
                    android:id="@+id/importantDates"
                    layout="@layout/item_dates" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_1" />

                <!-- Other Info -->
                <include
                    android:id="@+id/otherDetails"
                    layout="@layout/item_other_info" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Insurance details -->
        <include
            android:id="@+id/insuranceDetails"
            android:visibility="gone"
            layout="@layout/item_insurance_card" />

    </LinearLayout>



</ScrollView>