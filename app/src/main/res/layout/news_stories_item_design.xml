<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivCar"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginBottom="-80dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/temp_img1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:weightSum="3">

            <!-- Petrol -->
            <TextView
                android:id="@+id/newsHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hind_semibold"
                android:text=""
                android:maxLines="1"
                android:textColor="@color/text_heading"
                android:textSize="18sp" />

            <!-- Diesel -->
            <TextView
                android:id="@+id/newsTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hind"
                android:text="05 Feb 2025"
                android:textColor="@color/text_sub_heading_2"
                android:textSize="8sp" />

            <!-- CNG -->
            <TextView
                android:id="@+id/newsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/hind"
                android:maxLines="3"
                android:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's more......"
                android:textColor="@color/text_heading"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>