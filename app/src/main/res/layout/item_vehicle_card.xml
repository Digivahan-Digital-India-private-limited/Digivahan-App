<?xml version="1.0" encoding="utf-8"?>
<!-- Vehicle & PUC Expired Card -->
<androidx.cardview.widget.CardView android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/mainCardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/bg_card4"
        android:gravity="center_vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivCar"
                android:layout_width="110dp"
                android:layout_height="70dp"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_vehicle_default" />

            <TextView
                android:id="@+id/tvCarNo"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_below="@id/ivCar"
                android:background="@drawable/number_plate_bg"
                android:gravity="center"
                android:paddingStart="15dp"
                android:fontFamily="@font/hind_bold"
                android:text="KA 18 EQ 0001"
                android:textColor="@color/text_heading"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/cardLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="5dp"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/carDetailsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/carOwner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_string"
                    android:maxLines="1"
                    android:fontFamily="@font/hind_bold"
                    android:textColor="@color/text_heading"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/carModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_string"
                    android:maxLines="2"
                    android:fontFamily="@font/hind"
                    android:textColor="@color/text_heading"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/registrationData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_string"
                    android:fontFamily="@font/hind"
                    android:textColor="@color/text_heading"
                    android:textSize="8sp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/pucInsuranceExpiryLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/read_light_icon"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:visibility="visible"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/pucLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="visible"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pucExpiryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="6dp"
                            android:text="PUC EXPIRED"
                            android:textAlignment="center"
                            android:drawablePadding="5dp"
                            android:textColor="@color/warning"
                            android:textSize="12sp"
                            android:fontFamily="@font/hind_bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/tvPucDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:fontFamily="@font/hind"
                            android:textColor="@color/text_heading"
                            android:textSize="8sp"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/insuranceLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="visible"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/insuranceExpiryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="6dp"
                            android:text="INSURANCE EXPIRED"
                            android:textAlignment="center"
                            android:drawablePadding="5dp"
                            android:textColor="@color/warning"
                            android:textSize="10sp"
                            android:fontFamily="@font/hind_bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/tvInsuranceDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:fontFamily="@font/hind"
                            android:textColor="@color/text_heading"
                            android:textSize="8sp"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <TextView
                android:id="@+id/carCardBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Details"
                android:textSize="12sp"
                android:paddingHorizontal="5dp"
                android:gravity="center"
                android:layout_marginVertical="5dp"
                android:background="@drawable/button_bg1"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@color/white"
                android:layout_marginHorizontal="30dp"
                android:fontFamily="@font/hind_bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>