<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:id="@+id/trendingVSCarItemLayout"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="10dp"
    android:gravity="center"
    android:background="@drawable/campare_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Car Image -->
        <ImageView
            android:id="@+id/carImg1"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="5dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_vehicle_default"/>

        <!-- Car Name -->
        <TextView
            android:id="@+id/tvCarName1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tucson"
            android:fontFamily="@font/hind_bold"
            android:textSize="10sp"
            android:maxLines="2"
            android:textColor="@color/white"
            android:gravity="center"/>

        <!-- Brand -->
        <TextView
            android:id="@+id/tvBrand1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hyundai"
            android:textSize="8sp"
            android:visibility="gone"
            android:maxLines="2"
            android:fontFamily="@font/hind_medium"
            android:textColor="@android:color/black"
            android:gravity="center"/>

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹29.27 lack"
            android:fontFamily="@font/hind_bold"
            android:textSize="12sp"
            android:maxLines="2"
            android:textColor="@color/white"
            android:background="@android:color/transparent"
            android:gravity="center"/>

    </LinearLayout>

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivProfile"
        android:layout_width="60dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_margin="3dp"
        android:src="@drawable/vs_icon" />

    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Car Image -->
        <ImageView
            android:id="@+id/carImg2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="5dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_vehicle_default"/>

        <!-- Car Name -->
        <TextView
            android:id="@+id/tvCarName2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tucson"
            android:maxLines="2"
            android:fontFamily="@font/hind_bold"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:gravity="center"/>

        <!-- Brand -->
        <TextView
            android:id="@+id/tvBrand2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hyundai"
            android:textSize="8sp"
            android:maxLines="2"
            android:visibility="gone"
            android:fontFamily="@font/hind_medium"
            android:textColor="@android:color/black"
            android:gravity="center"/>

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹29.27 lack"
            android:maxLines="2"
            android:fontFamily="@font/hind_bold"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@android:color/transparent"
            android:gravity="center"/>

    </LinearLayout>


</LinearLayout>
