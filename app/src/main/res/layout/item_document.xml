<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/documentLayout"
    android:background="@drawable/document_vault_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_marginVertical="10dp"
    android:layout_marginHorizontal="24dp"
    android:padding="12dp">

    <ImageView
        android:id="@+id/documentIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="6dp"
        android:background="@drawable/circle_bg"
        android:backgroundTint="@color/border_3"
        android:src="@drawable/profile_icon1"
        app:tint="@color/Primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:fontFamily="@font/hind_bold" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:fontFamily="@font/hind"
            android:textColor="@color/text_color3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnView"
            android:layout_width="55dp"
            android:layout_height="20dp"
            android:background="@drawable/button_bg1"
            android:backgroundTint="@color/primary_button"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/hind_bold"
            android:text="View"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="8sp" />
    </LinearLayout>

</LinearLayout>
