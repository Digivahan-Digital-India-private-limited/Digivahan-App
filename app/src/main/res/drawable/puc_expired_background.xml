<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer border (Red) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stork_color" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Inner gradient background -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/gradient_color"
                android:startColor="@color/gradient_color1" />
            <corners android:radius="6dp" />
        </shape>
    </item>

</layer-list>
