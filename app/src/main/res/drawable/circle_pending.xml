<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer light circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFF5E5" />
        </shape>
    </item>

    <!-- Inner solid circle -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFD699" />
        </shape>
    </item>
</layer-list>
