<resources>
    <declare-styleable name="OtpView">
        <attr name="otpLength" format="integer" />
        <attr name="boxSize" format="dimension" /> <!-- keep old one for compatibility -->
        <attr name="boxWidth" format="dimension" />
        <attr name="boxHeight" format="dimension" />
        <attr name="boxSpacing" format="dimension" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="boxBackground" format="reference" />
        <attr name="boxElevation" format="dimension" />
    </declare-styleable>


    <declare-styleable name="ProfileCircularProgress">
        <attr name="pcp_progress" format="integer"/>
        <attr name="pcp_max" format="integer"/>
        <attr name="pcp_trackColor" format="color"/>
        <attr name="pcp_indicatorColor" format="color"/>
        <attr name="pcp_trackThickness" format="dimension"/>
        <attr name="pcp_indicatorThickness" format="dimension"/>
        <attr name="pcp_startAtBottom" format="boolean"/>
    </declare-styleable>


    <declare-styleable name="SemiCircleProgressView">
        <attr name="progress" format="float" />
        <attr name="progressColor" format="color" />
        <attr name="trackColor" format="color" />
        <attr name="progressThickness" format="dimension" /> <!-- NEW ATTRIBUTE -->
    </declare-styleable>


    <declare-styleable name="gvb">
        <attr name="gvb_show_text" format="boolean" />
        <attr name="gvb_draw" format="boolean" />
        <attr name="gvb_multiple" format="boolean" />
        <attr name="gvb_touch" format="boolean" />
        <attr name="gvb_auto_focus" format="boolean" />
        <attr name="gvb_flash" format="boolean" />
        <attr name="gvb_rect_colors" format="reference" />
        <attr name="gvb_camera_facing" format="enum">
            <enum name="back" value="0" />
            <enum name="front" value="0" />
        </attr>
        <attr name="gvb_code_format">
            <flag name="all_format" value="0"></flag>
            <flag name="code_128" value="1"></flag>
            <flag name="code_39" value="2"></flag>
            <flag name="code_93" value="4"></flag>
            <flag name="code_bar" value="8"></flag>
            <flag name="data_matrix" value="16"></flag>
            <flag name="ean_13" value="32"></flag>
            <flag name="ean_8" value="64"></flag>
            <flag name="itf" value="128"></flag>
            <flag name="qr_code" value="256"></flag>
            <flag name="upc_a" value="512"></flag>
            <flag name="upc_e" value="1024"></flag>
            <flag name="pdf417" value="2028"></flag>
            <flag name="aztec" value="4029"></flag>
        </attr>

    </declare-styleable>


    <declare-styleable name="RoundCornerProgressBar">
        <attr name="rcpb_stroke_width" format="dimension" />
        <attr name="rcpb_stroke_color" format="color" />
        <attr name="rcpb_progress_color" format="color" />
        <attr name="rcpb_progress" format="float" />
    </declare-styleable>


</resources>
